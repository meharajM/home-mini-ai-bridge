# OpenAI-compatible chat endpoint. Ollama defaults to http://127.0.0.1:11434/v1.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma3:1b
LLM_API_KEY=
LLM_SYSTEM_PROMPT="Answer conversationally in no more than two concise spoken sentences."

# Piper HTTP server: .venv-piper/bin/python -m piper.http_server --host 127.0.0.1 --port 5001 --data-dir .piper -m en_US-lessac-medium
PIPER_URL=http://127.0.0.1:5001/synthesize

# POC stays loopback-only and never casts unless explicitly enabled.
HOST=127.0.0.1
PORT=8787
CAST_ENABLED=false
CAST_DEVICE_IP=
PYCHROMECAST_PYTHON=.venv/bin/python

# When casting, set to a LAN URL reachable by the Mini, e.g. http://192.168.1.20:8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Required for LAN binding: generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# At least 32 characters, 8 distinct characters, no whitespace.
TURN_API_TOKEN=

# Persistent hash-only idempotency records; one bridge process per directory.
DATA_DIR=.data
# Waiting turns in addition to the one active turn; overload returns HTTP 429.
MAX_WAITING_TURNS=8
